# ==============================================================
#  BACKEND ORTAM DEĞİŞKENLERİ
#  Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
#  .env dosyasını ASLA git'e commit etmeyin.
# ==============================================================

# --- Sunucu ---------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Virgülle ayrılmış izinli origin listesi
CORS_ORIGIN=http://localhost:5173

# --- Rate limit -----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ==============================================================
#  METADATA SAĞLAYICILARI
# ==============================================================

# --- Spotify Web API (Client Credentials Flow) ----------------
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=TR

# --- Apple Music API (MusicKit Developer Token / JWT) ---------
# https://developer.apple.com/account/resources/authkeys/list
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# .p8 dosyasının yolu (veya aşağıdaki inline değişkeni kullanın)
APPLE_MUSIC_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_MUSIC_STOREFRONT=tr
# Anahtar yoksa iTunes Search API'ye (anahtarsız) fallback yapılır
APPLE_MUSIC_USE_ITUNES_FALLBACK=true

# --- Deezer Public API ----------------------------------------
# Public metadata endpoint'leri anahtar gerektirmez
DEEZER_API_BASE_URL=https://api.deezer.com

# --- YouTube Music / YouTube Data API v3 ----------------------
# Opsiyonel: boşsa metadata yt-dlp ile çekilir
YOUTUBE_API_KEY=

# --- Platformlar arası eşleştirme (Odesli / song.link) --------
# Opsiyonel: anahtarsız da çalışır, anahtar daha yüksek limit sağlar
ODESLI_API_KEY=

# --- MusicBrainz (ISRC doğrulama, opsiyonel) ------------------
# MusicBrainz, iletişim bilgisi içeren bir User-Agent ister
MUSICBRAINZ_USER_AGENT=FlacSync/0.1.0 ( your-contact@example.com )

# ==============================================================
#  EŞLEŞTİRME (MATCHER)
# ==============================================================
# Süre farkı toleransı (ms)
MATCH_DURATION_TOLERANCE_MS=3000
# 0-1 arası minimum benzerlik skoru (başlık + sanatçı + süre)
MATCH_MIN_SCORE=0.75
# Kaynak başına denenecek maksimum aday sayısı
MATCH_MAX_CANDIDATES=5

# ==============================================================
#  AUDIO RESOLVER (ses kaynağı eşleştirme)
# ==============================================================
# Ses kaynağı için süre toleransı (ms) — ±5 sn
RESOLVER_DURATION_TOLERANCE_MS=5000
# Bir adayın kabul edilmesi için minimum skor (0-1)
RESOLVER_MIN_SCORE=0.8
# Eşleşme önbellek süresi (ms). Akış URL'si daha erken sona ererse o kullanılır.
RESOLVER_CACHE_TTL_MS=3600000
# Aynı anda çalışabilecek yt-dlp süreci sayısı
YTDLP_CONCURRENCY=3

# ==============================================================
#  İNDİRME / DÖNÜŞTÜRME
# ==============================================================
DOWNLOAD_DIR=./storage/downloads
TEMP_DIR=./storage/temp
# flac | mp3
DEFAULT_AUDIO_FORMAT=flac
# mp3 için kbps
MP3_BITRATE=320
# FLAC sıkıştırma seviyesi (0-12)
FLAC_COMPRESSION_LEVEL=8
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_MS=300000
# Tamamlanan dosyaların sunucuda tutulma süresi (dakika)
FILE_RETENTION_MINUTES=60

# Binary yolları (boşsa yt-dlp-exec / ffmpeg-static varsayılanları)
YTDLP_PATH=
FFMPEG_PATH=
# Opsiyonel: yt-dlp için Netscape formatında cookies dosyası
YTDLP_COOKIES_FILE=
